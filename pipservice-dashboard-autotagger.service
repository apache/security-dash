[Unit]
Description=ASF Security Dashboard Autotagger

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=UV_PYTHON=/usr/bin/python3
Environment=UV_PYTHON_DOWNLOADS=never
Type=oneshot
WorkingDirectory=/opt/dashboard-autotagger
ExecStart=/usr/local/bin/uv run --frozen tag-all.py
Restart=no
TemporaryFileSystem=/
BindReadOnlyPaths=/usr /opt/dashboard-autotagger /opt/pipx/venvs/uv /lib /lib64 /bin /sbin /etc/resolv.conf /etc/nsswitch.conf /etc/ssl/certs
