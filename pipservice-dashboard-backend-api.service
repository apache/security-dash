[Unit]
Description=ASF Security Dashboard Backend API

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=UV_PYTHON=/usr/bin/python3
Environment=UV_PYTHON_DOWNLOADS=never
Type=exec
WorkingDirectory=/opt/dashboard-backend-api
PIDFile=/opt/dashboard-backend-api/state/dashboard-backend-api.pid
ExecStart=/usr/local/bin/uv run --frozen hypercorn server:application
ExecReload=/bin/kill -SIGINT $MAINPID
Restart=always
MountAPIVFS=yes
TemporaryFileSystem=/
BindReadOnlyPaths=/usr /opt/dashboard-backend-api /opt/email-classification /opt/pipx/venvs/uv /lib /lib64 /bin /sbin /etc/resolv.conf /etc/nsswitch.conf /etc/ssl/certs

[Install]
WantedBy=multi-user.target
